<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.soft.mapper.BedNurseMapper">

    <resultMap id="BaseResultMap" type="com.soft.pojo.BedNurse">
            <id property="id" column="id" jdbcType="INTEGER"/>
            <result property="bedId" column="bed_id" jdbcType="INTEGER"/>
            <result property="nurseId" column="nurse_id" jdbcType="INTEGER"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,bed_id,nurse_id,
        create_time,update_time
    </sql>

    <!-- 查询床位的护理员ID列表 -->
    <select id="selectNurseIdsByBedId" resultType="integer">
        SELECT nurse_id FROM t_bed_nurse WHERE bed_id = #{bedId}
    </select>

    <!-- 批量插入床位护理员关联 -->
    <insert id="batchInsertBedNurses">
        INSERT INTO t_bed_nurse (bed_id, nurse_id, create_time, update_time) VALUES
        <foreach collection="nurseIds" item="nurseId" separator=",">
            (#{bedId}, #{nurseId}, NOW(), NOW())
        </foreach>
    </insert>

    <!-- 删除床位的护理员关联 -->
    <delete id="deleteByBedId">
        DELETE FROM t_bed_nurse WHERE bed_id = #{bedId}
    </delete>
</mapper>
