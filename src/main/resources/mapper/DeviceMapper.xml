<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.soft.mapper.DeviceMapper">

    <resultMap id="BaseResultMap" type="com.soft.pojo.Device">
            <id property="id" column="id" jdbcType="INTEGER"/>
            <result property="deviceName" column="device_name" jdbcType="VARCHAR"/>
            <result property="remarkName" column="remark_name" jdbcType="VARCHAR"/>
            <result property="productName" column="product_name" jdbcType="VARCHAR"/>
            <result property="locationType" column="location_type" jdbcType="TINYINT"/>
            <result property="locationId" column="location_id" jdbcType="INTEGER"/>
            <result property="status" column="status" jdbcType="TINYINT"/>
            <result property="createUser" column="create_user" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,device_name,remark_name,
        product_name,location_type,location_id,
        status,create_user,create_time,
        update_time
    </sql>
</mapper>
