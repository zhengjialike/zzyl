<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.soft.mapper.CustomerMapper">

    <resultMap id="BaseResultMap" type="com.soft.pojo.Customer">
            <id property="id" column="id" jdbcType="INTEGER"/>
            <result property="openid" column="openid" jdbcType="VARCHAR"/>
            <result property="unionid" column="unionid" jdbcType="VARCHAR"/>
            <result property="nickname" column="nickname" jdbcType="VARCHAR"/>
            <result property="avatarUrl" column="avatar_url" jdbcType="VARCHAR"/>
            <result property="phone" column="phone" jdbcType="VARCHAR"/>
            <result property="realName" column="real_name" jdbcType="VARCHAR"/>
            <result property="status" column="status" jdbcType="TINYINT"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,openid,unionid,
        nickname,avatar_url,phone,
        real_name,status,create_time,
        update_time
    </sql>

    <!-- 检查客户是否已签约（是否存在相关合同） -->
    <select id="checkContractExists" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM t_contract c
            INNER JOIN t_elderly e ON c.elder_id = e.id
            INNER JOIN t_family_binding fb ON e.id = fb.elderly_id
            WHERE fb.customer_id IN (
                SELECT id FROM t_customer WHERE phone = #{phone}
            )
        )
    </select>

    <!-- 查询客户的订单数量（状态为已完成或待执行） -->
    <select id="getOrderCountByPhone" resultType="integer">
        SELECT COUNT(*) FROM t_order o
        INNER JOIN t_customer c ON o.customer_id = c.id
        WHERE c.phone = #{phone}
          AND o.status IN (1, 3)
    </select>

    <!-- 查询客户绑定的所有老人姓名 -->
    <select id="getBoundElderlyNames" resultType="string">
        SELECT e.real_name
        FROM t_family_binding fb
        INNER JOIN t_elderly e ON fb.elderly_id = e.id
        WHERE fb.customer_id = #{customerId}
    </select>

</mapper>
